# Home Library settings.
#
# Copy this file to `.env` in the same folder as docker-compose.yml:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically - it is never committed to git.

# Your login PIN. Anything you like; 6+ digits is easier to type on a phone.
# If you leave this blank or delete this file, the app generates a PIN and
# prints it once:   docker compose logs | grep -i pin
BOOKSHELF_PIN=change-me

# Optional: only if you want the port on the host changed.
# PORT=8080

# Optional. A free Google Books API key adds ratings and descriptions for books
# Open Library has no rating for. Series data does NOT come from Google (their
# Volume schema has no series field) - that comes from Wikidata, no key needed.
# GOOGLE_BOOKS_KEY=
