# Home Library settings.
#
# Copy this file to `.env` in the same folder as docker-compose.yml:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically - it is never committed to git.

# Your login. Set both, or neither.
#
# If both are set, the app creates this account on first start and then keeps
# the password in step with this file on every restart - which is also the
# recovery path if the password is forgotten: change it here, restart.
#
# If both are left blank, the app prints a one-time setup code in its log on
# first run and you create the account in the browser with that code:
#   docker compose logs | grep -i "setup code"
BOOKSHELF_USERNAME=admin
BOOKSHELF_PASSWORD=change-me-to-something-long

# Optional: only if you want the port on the host changed.
# PORT=8080

# Optional. A free Google Books API key adds ratings and descriptions for books
# Open Library has no rating for. Series data does NOT come from Google (their
# Volume schema has no series field) - that comes from Wikidata, no key needed.
# GOOGLE_BOOKS_KEY=
